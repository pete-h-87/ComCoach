GEMINI_API_KEY=xyz

# User must provide their API key of choice, or a way to connect to their local LLM


DATABASE_URL=postgres://user:password@localhost:5432/dbname

# DATABASE_URL is the Postgres connection string used by the server.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
#   user     - Postgres role to connect as (often "postgres" on a fresh local install)
#   password - that role's password (URL-encode any special characters, e.g. "@" -> "%40")
#   host     - hostname or IP of the Postgres server ("localhost" for local dev)
#   port     - Postgres port (5432 is the default)
#   database - name of the database to connect to (case-sensitive if quoted at creation)

